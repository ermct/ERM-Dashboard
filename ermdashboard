        <ul><li data-i18n="mgmt_i1"></li><li data-i18n="mgmt_i2"></li></ul>
      </div>
    </div>
    <p style="font-size:11.5px; color:var(--ink-faint); margin-top:8px;" data-i18n="mgmt_disclaimer"></p>
  </main>

  <!-- VIEW 2: LANDSCAPE -->
  <main id="view-landscape" class="view-pane">
    <div class="grid2">
      <div class="panel">
        <div class="section-label" style="margin-bottom:14px;" data-i18n="sec_heatmap"></div>
        <div class="heatmap-wrap">
        <div class="heatmap-grid">
          <div></div>
          <div class="hx-axis" data-i18n="esc_lo"></div>
          <div class="hx-axis" data-i18n="esc_md"></div>
          <div class="hx-axis" data-i18n="esc_hi"></div>

          <div class="hy-axis" data-i18n="imp_hi"></div>
