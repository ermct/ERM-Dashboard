            <span class="chip" onclick="navigateToSignal('s5')"><span class="n">5</span><span data-i18n="chip_s5"></span></span>
          </div>
          <div class="hcell i-md e-hi">
            <span class="chip" onclick="navigateToSignal('s3')"><span class="n">3</span><span data-i18n="chip_s3"></span></span>
