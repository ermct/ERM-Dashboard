            <tr><td><strong data-i18n="geo_r6"></strong></td><td data-i18n="geo_e6"></td><td><span class="badge-status monitor"><span class="dot"></span>Monitor</span></td><td data-i18n="geo_n6"></td></tr>
            <tr><td><strong data-i18n="geo_r7"></strong></td><td data-i18n="geo_e7"></td><td><span class="badge-status background"><span class="dot"></span>Background</span></td><td data-i18n="geo_n7"></td></tr>
