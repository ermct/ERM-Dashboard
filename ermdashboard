      <div class="row"><span data-i18n="lbl_window"></span> <span data-i18n="val_window"></span></div>
      <div class="row"><span data-i18n="lbl_scope"></span> <span data-i18n="val_scope"></span></div>
    </div>
  </div>

  <!-- VIEW 1: OVERVIEW -->
  <main id="view-overview" class="view-pane active">
    <div class="spotlight-box">
      <div class="spotlight-header">
        <div class="spotlight-title" data-i18n="spotlight_title"></div>
        <div style="font-size:11px; color:var(--ink-faint);" data-i18n="spotlight_date"></div>
      </div>
      <div class="spotlight-grid">
        <div class="spot-card high">
          <div class="spot-head" data-i18n="spot_high_head"></div>
