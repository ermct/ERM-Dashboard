<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PTI ERM — External Risk Intelligence Platform</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#EAF2F5; --ink-dim:#9FB6C4; --ink-faint:#6E8494;
    --hull:#0A1B28; --deck:#0F2536; --panel:#132C40; --panel-line:#25445C; --panel-line-soft:#1C374A;
    --signal-amber:#E3A13B; --signal-red:#C7472E; --signal-teal:#3FA79A; --signal-green:#4E9A6E; --signal-blue:#4C86C7;
  }
  *{box-sizing:border-box;}
  body{margin:0; background:var(--hull); color:var(--ink); font-family:'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif; line-height:1.5;}

  header.app-header{position:sticky; top:0; z-index:100; background:rgba(10,27,40,.95); backdrop-filter:blur(8px); border-bottom:1px solid var(--panel-line); padding:0 20px;}
  .header-inner{max-width:1200px; margin:0 auto; display:flex; justify-content:space-between; align-items:center; height:62px; gap:16px;}
  .brand-area{display:flex; align-items:center; gap:12px;}
  .brand-logo{width:32px; height:32px; border-radius:6px; background:linear-gradient(135deg, var(--signal-teal), var(--signal-blue)); display:flex; align-items:center; justify-content:center; font-weight:700; font-family:'Space Grotesk'; font-size:14px; color:#fff;}
  .brand-title{font-family:'Space Grotesk'; font-weight:700; font-size:15px; letter-spacing:.02em; color:var(--ink); line-height:1.2;}
  .brand-sub{font-size:11px; color:var(--signal-teal); text-transform:uppercase; letter-spacing:.05em;}
  .nav-tabs{display:flex; gap:4px; height:100%; overflow-x:auto; scrollbar-width:none;}
  .nav-tabs::-webkit-scrollbar{display:none;}
  .nav-btn{background:transparent; border:none; color:var(--ink-dim); padding:0 14px; font-family:'IBM Plex Sans'; font-size:12.5px; font-weight:500; cursor:pointer; display:flex; align-items:center; gap:6px; white-space:nowrap; border-bottom:2px solid transparent; transition:all .15s ease;}
  .nav-btn:hover{color:var(--ink); background:rgba(255,255,255,.02);}
  .nav-btn.active{color:var(--signal-teal); border-bottom-color:var(--signal-teal); font-weight:600;}
  .nav-btn .badge-count{background:var(--panel-line); color:var(--ink); font-size:10px; padding:1px 6px; border-radius:10px; font-family:'Space Grotesk';}
  .nav-btn.active .badge-count{background:var(--signal-teal); color:#0A1B28; font-weight:700;}
  .header-actions{display:flex; align-items:center; gap:12px;}
  .update-status{background:rgba(76,154,110,.12); border:1px solid rgba(76,154,110,.35); color:#7FC79E; padding:6px 12px; border-radius:20px; font-size:11px; font-weight:600; font-family:'Space Grotesk'; display:flex; align-items:center; gap:6px;}
  .update-status .status-dot{width:6px; height:6px; border-radius:50%; background:#7FC79E;}
  .lang-toggle{display:inline-flex; background:var(--deck); border:1px solid var(--panel-line); border-radius:20px; padding:2px;}
  .lang-btn{background:transparent; border:none; color:var(--ink-faint); padding:3px 10px; font-size:11px; font-weight:600; border-radius:16px; cursor:pointer; transition:all .15s ease; font-family:'Space Grotesk';}
  .lang-btn.active{background:var(--signal-teal); color:#0A1B28;}

  .wrap{max-width:1200px; margin:0 auto; padding:24px 20px 60px;}
  .view-pane{display:none;} .view-pane.active{display:block;}

  .tip-wrap{position:relative; display:inline-flex; align-items:center; gap:5px;}
  .info-icon{width:14px;height:14px;border-radius:50%;border:1px solid var(--ink-faint); font-size:9px; display:inline-flex; align-items:center; justify-content:center; color:var(--ink-faint); cursor:help; flex-shrink:0;}
  .tip-bubble{position:absolute; bottom:calc(100% + 9px); left:50%; transform:translateX(-50%); background:#0D2131; border:1px solid var(--panel-line); border-radius:5px; padding:10px 13px; font-size:11.5px; line-height:1.5; color:var(--ink-dim); width:240px; opacity:0; visibility:hidden; transition:opacity .12s ease; z-index:80; pointer-events:none; box-shadow:0 10px 28px rgba(0,0,0,.4); text-align:left; font-weight:normal;}
  .tip-bubble b{color:var(--ink); font-weight:600;}
  .tip-bubble::after{content:''; position:absolute; top:100%; left:50%; transform:translateX(-50%); border:6px solid transparent; border-top-color:var(--panel-line);}
  .tip-wrap:hover .tip-bubble, .tip-wrap.show .tip-bubble{opacity:1; visibility:visible; pointer-events:auto;}
  .tip-wrap.right .tip-bubble{left:auto; right:0; transform:translateX(0);}
  .tip-wrap.right .tip-bubble::after{left:auto; right:10px; transform:translateX(0);}

  .masthead{display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:16px; border-bottom:1px solid var(--panel-line); padding-bottom:18px; margin-bottom:20px;}
  .masthead .brand{font-size:12px; letter-spacing:.06em; color:var(--signal-teal); margin-bottom:4px; text-transform:uppercase; font-weight:600;}
  .masthead h1{font-size:24px; font-weight:600; color:var(--ink); font-family:'Space Grotesk';}
  .masthead .sub{color:var(--ink-dim); font-size:13px; margin-top:3px;}
  .meta-block{font-size:12px; color:var(--ink-dim); text-align:right;}
  .meta-block .row{margin-bottom:2px;} .meta-block .row span{color:var(--ink);}

  .spotlight-box{background:linear-gradient(180deg, var(--panel), var(--deck)); border:1px solid var(--panel-line); border-radius:6px; padding:20px; margin-bottom:24px;}
  .spotlight-header{display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--panel-line-soft); padding-bottom:10px; margin-bottom:14px; flex-wrap:wrap; gap:8px;}
  .spotlight-title{font-family:'Space Grotesk'; font-size:13px; font-weight:700; letter-spacing:.05em; color:var(--signal-teal); text-transform:uppercase; display:flex; align-items:center; gap:8px;}
  .spotlight-title::before{content:''; width:8px; height:8px; border-radius:50%; background:var(--signal-teal);}
  .spotlight-grid{display:grid; grid-template-columns:1fr 1fr; gap:16px;}
  .spot-card{background:rgba(13,33,49,.6); border:1px solid var(--panel-line-soft); border-radius:6px; padding:14px 16px;}
  .spot-card.high{border-left:3px solid var(--signal-red);} .spot-card.monitor{border-left:3px solid var(--signal-amber);}
  .spot-head{font-family:'Space Grotesk'; font-size:12px; font-weight:700; margin-bottom:8px; display:flex; align-items:center; gap:6px;}
  .spot-card.high .spot-head{color:#E8896F;} .spot-card.monitor .spot-head{color:var(--signal-amber);}
  .spot-list{margin:0; padding-left:18px; font-size:12.5px; color:var(--ink-dim);}
  .spot-list li{margin-bottom:6px; line-height:1.45;} .spot-list li strong{color:var(--ink);}

  .section-label{font-size:12px; letter-spacing:.04em; color:var(--signal-teal); margin-bottom:12px; display:flex; align-items:center; gap:8px; text-transform:uppercase; font-weight:600;}
  .section-label::before{content:''; width:14px; height:1px; background:var(--signal-teal); display:inline-block;}

  .kpi-grid{display:grid; grid-template-columns:repeat(5,1fr); gap:12px; margin-bottom:28px;}
  .kpi{background:var(--panel); border:1px solid var(--panel-line); border-radius:6px; padding:16px 14px; position:relative; cursor:pointer; transition:transform .15s ease, border-color .15s ease;}
  .kpi:hover{transform:translateY(-2px); border-color:var(--signal-teal);}
  .kpi .num-row{display:flex; align-items:baseline; gap:8px;}
  .kpi .num{font-family:'Space Grotesk'; font-size:32px; font-weight:600; line-height:1;}
  .kpi .delta{font-size:11px; font-weight:700; padding:2px 7px; border-radius:10px; font-family:'Space Grotesk';}
  .kpi .delta.up{background:rgba(199,71,46,.16); color:#E8896F;}
  .kpi .delta.down{background:rgba(78,154,110,.16); color:#7FC79E;}
  .kpi .delta.same{background:rgba(158,182,196,.12); color:var(--ink-dim);}
  .kpi .label{font-size:11.5px; color:var(--ink-dim); margin-top:8px; display:flex; align-items:center; gap:5px; font-weight:500;}
  .kpi .snapshot-note{font-size:10px; color:var(--ink-faint); margin-top:8px; font-style:italic;}
  .kpi.high{border-left:4px solid var(--signal-red);} .kpi.high .num{color:var(--signal-red);}
  .kpi.monitor{border-left:4px solid var(--signal-amber);} .kpi.monitor .num{color:var(--signal-amber);}
  .kpi.background{border-left:4px solid var(--ink-faint);} .kpi.background .num{color:var(--ink-dim);}
  .kpi.total{border-left:4px solid var(--signal-teal);} .kpi.total .num{color:var(--signal-teal);}
  .kpi.info{border-left:4px solid var(--signal-blue);} .kpi.info .num{color:var(--signal-blue);}

  .grid2{display:grid; grid-template-columns:1.15fr .85fr; gap:20px; margin-bottom:28px; align-items:start;}
  .panel{background:var(--panel); border:1px solid var(--panel-line); border-radius:6px; padding:20px;}
  .panel h3{font-size:15px; font-weight:600; margin-bottom:14px; font-family:'Space Grotesk';}

  .heatmap-wrap{}
  .heatmap-grid{display:grid; grid-template-columns:76px repeat(3,1fr); gap:6px;}
  .hx-axis{font-size:10.5px; color:var(--ink-faint); text-align:center; padding:6px 2px; letter-spacing:.02em; font-weight:500;}
  .hy-axis{font-size:10.5px; color:var(--ink-faint); display:flex; align-items:center; justify-content:flex-end; padding-right:8px; text-align:right; line-height:1.3; font-weight:500;}
  .hcell{border-radius:4px; min-height:76px; padding:8px; position:relative; display:flex; flex-direction:column; gap:5px; cursor:default; border:1px solid var(--panel-line-soft);}
  .hcell.i-hi.e-lo{background:rgba(227,161,59,.16);} .hcell.i-hi.e-md{background:rgba(199,71,46,.22);} .hcell.i-hi.e-hi{background:rgba(199,71,46,.34);}
  .hcell.i-md.e-lo{background:rgba(63,167,154,.14);} .hcell.i-md.e-md{background:rgba(227,161,59,.20);} .hcell.i-md.e-hi{background:rgba(199,71,46,.24);}
  .hcell.i-lo.e-lo{background:rgba(63,167,154,.08);} .hcell.i-lo.e-md{background:rgba(63,167,154,.10);} .hcell.i-lo.e-hi{background:rgba(227,161,59,.10);}
  .chip{display:inline-flex; align-items:center; gap:5px; background:#0D2131; border:1px solid var(--panel-line); border-radius:20px; padding:3px 9px 3px 6px; font-size:10.5px; color:var(--ink); cursor:pointer; transition:border-color .12s ease, transform .12s ease; width:fit-content;}
  .chip:hover{border-color:var(--signal-teal); transform:translateY(-1px);}
  .chip .n{width:15px;height:15px;border-radius:50%; background:var(--panel-line); font-size:9px; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0; color:var(--signal-teal);}
  .legend{display:flex; gap:16px; margin-top:14px; flex-wrap:wrap; font-size:11px; color:var(--ink-dim);}
  .legend .lg{display:flex; align-items:center; gap:6px;} .legend .sw{width:11px;height:11px;border-radius:3px;}

  .trend-title-row{display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;}
  .trend-list{display:flex; flex-direction:column;}
  .trend-row{display:flex; justify-content:space-between; align-items:center; padding:11px 0; border-bottom:1px solid var(--panel-line-soft);}
  .trend-row:last-child{border-bottom:none;}
  .trend-row .name{font-size:13px; max-width:62%; color:var(--ink-dim);}
  .trend-tag{font-family:'Space Grotesk'; font-weight:600; font-size:11.5px; display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:20px; border:1px solid transparent;}
  .trend-tag.up{color:#E8896F; background:rgba(199,71,46,.14); border-color:rgba(199,71,46,.3);}
  .trend-tag.down{color:#7FC79E; background:rgba(78,154,110,.14); border-color:rgba(78,154,110,.3);}
  .trend-tag.stable{color:#8FB6E5; background:rgba(76,134,199,.14); border-color:rgba(76,134,199,.3);}
  .trend-tag.seasonal{color:#5FC2B8; background:rgba(63,167,154,.14); border-color:rgba(63,167,154,.3);}
  .trend-tag.uncertain{color:var(--ink-dim); background:rgba(158,182,196,.1); border-color:var(--panel-line);}

  .badge-status{display:inline-flex; align-items:center; gap:6px; padding:3px 10px; border-radius:20px; font-size:10.5px; font-weight:600; letter-spacing:.01em; white-space:nowrap;}
  .badge-status .dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;}
  .badge-status.high{background:rgba(199,71,46,.16); color:#E8896F; border:1px solid rgba(199,71,46,.35);} .badge-status.high .dot{background:var(--signal-red);}
  .badge-status.monitor{background:rgba(227,161,59,.16); color:var(--signal-amber); border:1px solid rgba(227,161,59,.35);} .badge-status.monitor .dot{background:var(--signal-amber);}
  .badge-status.background{background:rgba(158,182,196,.1); color:var(--ink-dim); border:1px solid var(--panel-line);} .badge-status.background .dot{background:var(--ink-faint);}

  .badge-level{display:inline-flex; align-items:center; gap:5px; padding:3px 9px; border-radius:4px; font-size:10.5px; font-weight:600; white-space:nowrap; border:1px solid var(--panel-line);}
  .badge-level .bars{display:flex; gap:2px; align-items:flex-end;}
  .badge-level .bars i{display:block; width:3px; background:var(--panel-line); border-radius:1px;}
  .badge-level .bars i:nth-child(1){height:5px;} .badge-level .bars i:nth-child(2){height:8px;} .badge-level .bars i:nth-child(3){height:11px;}
  .badge-level.lvl-high{color:#BFDAF7; background:rgba(76,134,199,.14);} .badge-level.lvl-high .bars i{background:var(--signal-blue);}
  .badge-level.lvl-medium{color:#9FC3E8; background:rgba(76,134,199,.08);} .badge-level.lvl-medium .bars i:nth-child(1),.badge-level.lvl-medium .bars i:nth-child(2){background:var(--signal-blue);}
  .badge-level.lvl-low{color:var(--ink-dim); background:rgba(158,182,196,.06);} .badge-level.lvl-low .bars i:nth-child(1){background:var(--signal-blue);}
  .trend-arrow{font-family:'Space Grotesk'; font-weight:700; font-size:14px; display:inline-flex; align-items:center; gap:5px;}
  .trend-arrow.up{color:var(--signal-red);} .trend-arrow.down{color:var(--signal-green);} .trend-arrow.stable{color:var(--signal-blue);} .trend-arrow.uncertain{color:var(--ink-dim);}

  .filter-bar{display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:16px; flex-wrap:wrap;}
  .filter-group{display:flex; gap:8px; align-items:center; flex-wrap:wrap;}
  .filter-btn{background:var(--deck); border:1px solid var(--panel-line); color:var(--ink-dim); font-size:11.5px; padding:5px 12px; border-radius:20px; cursor:pointer; transition:all .15s ease; font-family:'IBM Plex Sans';}
  .filter-btn:hover{color:var(--ink); border-color:var(--ink-faint);}
  .filter-btn.active{background:var(--signal-teal); color:#0A1B28; font-weight:600; border-color:var(--signal-teal);}

  .table-scroll{overflow-x:auto; -webkit-overflow-scrolling:touch; border-radius:5px;}
  .scroll-hint{display:none; font-size:10.5px; color:var(--ink-faint); margin-bottom:8px;}
  table{width:100%; border-collapse:collapse; font-size:12.5px; min-width:640px;}
  th{text-align:left; font-weight:600; color:var(--ink-dim); font-size:10.5px; letter-spacing:.03em; padding:10px 12px; border-bottom:1px solid var(--panel-line); text-transform:uppercase; white-space:nowrap; background:rgba(0,0,0,.15);}
  td{padding:12px 12px; border-bottom:1px solid var(--panel-line-soft); vertical-align:middle;}
  tr:last-child td{border-bottom:none;}
  tr.row-highlight{background:rgba(63,167,154,.12); transition:background .3s ease;}
  .clickable-row{cursor:pointer; transition:background .12s ease;} .clickable-row:hover{background:rgba(255,255,255,.02);}

  .full-panel{margin-bottom:28px;}
  ul.clean-bullets{margin:6px 0 10px; padding-left:18px; color:var(--ink); font-size:12.5px;}
  ul.clean-bullets li{margin-bottom:5px; line-height:1.5;}

  details.card{background:var(--panel); border:1px solid var(--panel-line); border-radius:6px; margin-bottom:14px; overflow:hidden;}
  details.card summary{list-style:none; cursor:pointer; padding:18px 20px; display:flex; justify-content:space-between; align-items:center; gap:16px;}
  details.card summary::-webkit-details-marker{display:none;}
  details.card summary .stitle{font-size:15px; font-weight:600; font-family:'Space Grotesk'; color:var(--ink);}
  details.card summary .smeta{font-size:11.5px; color:var(--ink-dim); margin-top:6px; display:flex; align-items:center; gap:10px; flex-wrap:wrap;}
  details.card summary .chev{color:var(--signal-teal); font-size:20px; transition:transform .2s; flex-shrink:0; font-weight:600;}
  details.card[open] summary .chev{transform:rotate(45deg);}
  .card-body{padding:0 20px 22px; border-top:1px solid var(--panel-line);}
  .flow{display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin:16px 0; font-size:12px;}
  .flow .step{background:#0D2131; border:1px solid var(--panel-line); border-radius:4px; padding:8px 12px; color:var(--ink-dim); flex:1 1 150px; min-width:130px;}
  .flow .arrow{color:var(--signal-teal); font-size:16px;}
  .kv{display:grid; grid-template-columns:150px 1fr; gap:6px 14px; font-size:12.5px; margin:16px 0;}
  .kv dt{color:var(--ink-faint); font-size:11.5px;} .kv dd{margin:0; color:var(--ink);}
  .kv dd a{color:var(--signal-teal); text-decoration:none;} .kv dd a:hover{text-decoration:underline;}
  .badge-row{display:flex; gap:8px; flex-wrap:wrap; margin:14px 0 16px;}
  .subhead{font-size:11.5px; letter-spacing:.04em; color:var(--signal-teal); margin:18px 0 6px; font-weight:600; text-transform:uppercase;}
  p.body-text{font-size:13px; color:var(--ink); margin:4px 0 10px; line-height:1.55;}
  .fact{border-left:3px solid var(--signal-blue); padding-left:12px; margin:8px 0;}
  .inference{border-left:3px solid var(--signal-amber); padding-left:12px; margin:8px 0;}
  .tiny-label{font-size:10px; text-transform:uppercase; letter-spacing:.06em; color:var(--ink-faint); display:block; margin-bottom:3px; font-weight:600;}
  .correction-note{background:rgba(76,134,199,.08); border:1px solid rgba(76,134,199,.3); border-radius:5px; padding:10px 12px; font-size:11.5px; color:#9FC3E8; margin:10px 0;}
  .correction-note b{color:#BFDAF7;}

  .relevance-block{background:#0D2131; border:1px solid var(--panel-line); border-radius:6px; padding:14px 16px; margin:16px 0;}
  .relevance-tag{font-family:'Space Grotesk'; font-size:11.5px; font-weight:700; letter-spacing:.03em; margin-bottom:6px; display:inline-block;}
  .relevance-tag.contextual{color:var(--signal-amber);} .relevance-tag.watch{color:var(--ink-dim);}
  .relevance-context{font-size:12.5px; color:var(--ink-dim); line-height:1.5;} .relevance-context b{color:var(--ink);}

  .watch-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:16px;}
  .watch-item{background:var(--panel); border:1px solid var(--panel-line); border-radius:6px; padding:18px 20px;}
  .watch-item h4{font-size:14.5px; font-family:'Space Grotesk'; margin-bottom:12px; color:var(--ink);}
  .watch-field{margin-bottom:10px; font-size:12.5px;}
  .watch-field .fl{font-size:10px; text-transform:uppercase; letter-spacing:.04em; color:var(--ink-faint); display:block; margin-bottom:3px; font-weight:600;}
  .watch-field .fv{color:var(--ink-dim);}
  .watch-src{margin-top:14px; padding-top:10px; border-top:1px solid var(--panel-line-soft); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:6px;}
  .watch-src a{color:var(--signal-teal); text-decoration:none; font-size:12px; font-weight:500;} .watch-src a:hover{text-decoration:underline;}
  .watch-src .src-date{font-size:10.5px; color:var(--ink-faint);}

  .mgmt-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:12px;}
  .mgmt-col{border-radius:6px; padding:18px 20px; border:1px solid var(--panel-line);}
  .mgmt-col.attn{background:rgba(199,71,46,.08); border-color:rgba(199,71,46,.35);}
  .mgmt-col.mon{background:rgba(227,161,59,.08); border-color:rgba(227,161,59,.35);}
  .mgmt-col.info{background:rgba(76,134,199,.08); border-color:rgba(76,134,199,.35);}
  .mgmt-col h4{font-size:12.5px; font-family:'Space Grotesk'; margin-bottom:12px; text-transform:uppercase; letter-spacing:.03em;}
  .mgmt-col.attn h4{color:#E8896F;} .mgmt-col.mon h4{color:var(--signal-amber);} .mgmt-col.info h4{color:#8FB6E5;}
  .mgmt-col ul{margin:0; padding-left:16px; font-size:12.5px; color:var(--ink-dim);} .mgmt-col li{margin-bottom:8px;}

  .src-list{font-size:12.5px; color:var(--ink-dim);} .src-list li{margin-bottom:10px;}
  .src-list a{color:var(--signal-teal); text-decoration:none;} .src-list a:hover{text-decoration:underline;}
  .src-cat{font-size:11px; color:var(--signal-teal); margin:18px 0 8px; text-transform:uppercase; letter-spacing:.04em; font-weight:600;}

  details.methodology{background:var(--panel); border:1px solid var(--panel-line); border-radius:6px; margin-top:24px;}
  details.methodology summary{padding:14px 20px; cursor:pointer; font-size:12px; color:var(--ink-dim); display:flex; align-items:center; gap:8px; list-style:none;}
  details.methodology summary::-webkit-details-marker{display:none;}
  details.methodology summary::before{content:'ⓘ'; color:var(--signal-teal); font-weight:bold;}
  details.methodology .m-body{padding:0 20px 18px; font-size:12px; color:var(--ink-faint); line-height:1.6;}
  footer{margin-top:24px; padding-top:16px; border-top:1px solid var(--panel-line); font-size:11.5px; color:var(--ink-faint); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;}

  @media (max-width:960px){
    .spotlight-grid{grid-template-columns:1fr;} .kpi-grid{grid-template-columns:repeat(3,1fr);}
    .grid2{grid-template-columns:1fr;} .watch-grid{grid-template-columns:1fr;} .mgmt-grid{grid-template-columns:1fr;}
  }
  @media (max-width:640px){
    .kpi-grid{grid-template-columns:repeat(2,1fr);} .kpi.total{grid-column: span 2;}
    .header-inner{height:auto; padding:12px 0 0 0; flex-direction:column; align-items:stretch; gap:12px;}
    .brand-area{justify-content:center;} .header-actions{align-self:center; margin-top:0;}
    .nav-tabs{width:100%; border-top:1px solid var(--panel-line-soft); padding-top:10px; padding-bottom:6px;}
    .heatmap-wrap{overflow-x:auto; padding-bottom:10px; border-radius:5px;}
    .heatmap-grid{grid-template-columns:52px repeat(3, minmax(90px, 1fr)); min-width:380px;}
    .scroll-hint{display:block;} .kv{grid-template-columns:1fr; gap:2px 0;} .kv dt{margin-top:10px;}
    .masthead{flex-direction:column; align-items:flex-start;} .meta-block{text-align:left;}
  }
</style>
</head>
<body>

<header class="app-header">
  <div class="header-inner">
    <div class="brand-area">
      <div class="brand-logo">PTI</div>
      <div><div class="brand-title">ERM Intelligence</div><div class="brand-sub" data-i18n="brand_sub"></div></div>
    </div>
    <nav class="nav-tabs" id="main-nav">
      <button class="nav-btn active" data-view="overview"><span data-i18n="nav_overview"></span></button>
      <button class="nav-btn" data-view="landscape"><span data-i18n="nav_landscape"></span></button>
      <button class="nav-btn" data-view="signals"><span data-i18n="nav_signals"></span><span class="badge-count">8</span></button>
