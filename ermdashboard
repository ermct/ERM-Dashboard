        <div class="snapshot-note" data-i18n="kpi_note"></div>
      </div>
      <div class="kpi info" onclick="switchView('landscape')">
        <div class="num-row"><div class="num">4</div><span class="delta up">+1</span></div>
        <div class="label"><span data-i18n="kpi_cross"></span><span class="tip-wrap right"><span class="info-icon">i</span><span class="tip-bubble" data-i18n="tip_kpi_cross"></span></span></div>
        <div class="snapshot-note" data-i18n="kpi_note"></div>
      </div>
