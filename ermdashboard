      </div>
      <div class="kpi high" onclick="switchView('signals','high')">
        <div class="num-row"><div class="num">2</div><span class="delta down">−1</span></div>
        <div class="label"><span data-i18n="kpi_high"></span><span class="tip-wrap"><span class="info-icon">i</span><span class="tip-bubble" data-i18n="tip_kpi_high"></span></span></div>
        <div class="snapshot-note" data-i18n="kpi_note"></div>
      </div>
      <div class="kpi monitor" onclick="switchView('signals','monitor')">
