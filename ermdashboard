        <div class="label"><span data-i18n="kpi_monitor"></span><span class="tip-wrap"><span class="info-icon">i</span><span class="tip-bubble" data-i18n="tip_kpi_monitor"></span></span></div>
        <div class="snapshot-note" data-i18n="kpi_note"></div>
      </div>
      <div class="kpi background" onclick="switchView('signals','background')">
