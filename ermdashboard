  let currentLang = 'id';
  function setLanguage(lang) {
    currentLang = lang;
    document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));
    document.getElementById('lang-' + lang).classList.add('active');
    const dict = i18n[lang];
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (dict[key]) el.innerHTML = dict[key];
    });
  }

  function switchView(viewId, filterArg) {
    document.querySelectorAll('.nav-btn').forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-view') === viewId);
    });
    document.querySelectorAll('.view-pane').forEach(pane => pane.classList.remove('active'));
    const targetPane = document.getElementById('view-' + viewId);
    if (targetPane) { targetPane.classList.add('active'); window.scrollTo({ top: 0, behavior: 'smooth' }); }
    if (viewId === 'signals' && filterArg) {
      const filterBtn = document.querySelector(`.filter-btn[onclick*="${filterArg}"]`) || document.querySelectorAll('.filter-btn')[0];
      filterSignals(filterArg, filterBtn);
    }
  }
  document.querySelectorAll('.nav-btn').forEach(btn => {
    btn.addEventListener('click', function() { switchView(this.getAttribute('data-view')); });
  });

  function navigateToSignal(signalId) {
    switchView('deepdive');
    setTimeout(() => {
      const card = document.getElementById('card-' + signalId);
      if (card) {
        document.querySelectorAll('details.card').forEach(c => c.removeAttribute('open'));
        card.setAttribute('open', 'true');
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }, 150);
  }

  function filterSignals(category, btnEl) {
    if (btnEl) { document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active')); btnEl.classList.add('active'); }
    document.querySelectorAll('.signal-row').forEach(row => {
      if (category === 'all') row.style.display = '';
      else row.style.display = row.classList.contains('status-' + category) ? '' : 'none';
    });
  }

  document.querySelectorAll('.tip-wrap').forEach(function(el){
    el.addEventListener('click', function(e){
      var isOpen = el.classList.contains('show');
      document.querySelectorAll('.tip-wrap.show').forEach(function(o){ o.classList.remove('show'); });
      if(!isOpen){ el.classList.add('show'); }
      e.stopPropagation();
    });
  });
  document.addEventListener('click', function(){
    document.querySelectorAll('.tip-wrap.show').forEach(function(o){ o.classList.remove('show'); });
  });

  setLanguage('id');
</script>
